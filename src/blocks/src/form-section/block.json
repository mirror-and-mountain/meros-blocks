{
    "$schema": "https://json.schemastore.org/block.json",
    "apiVersion": 3,
    "name": "meros/form-section",
    "version": "0.1.0",
    "title": "Form Section",
    "category": "widgets",
    "icon": "format-gallery",
    "description": "A form section block",
    "textdomain": "meros-theme",
    "example": {},
    "editorScript": "file:./index.js",
    "parent": ["meros/form"],
    "allowedBlocks": ["meros/form-row"],
    "supports": {
        "allowedBlocks": true,
         "spacing": {
            "padding": true,
            "margin": true
        }
    },
    "attributes": {
        "conditions": {
            "type": "object",
            "default": {
                "show": [],
                "hide": []
            }
        }
    }
}