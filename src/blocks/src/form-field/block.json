{
    "$schema": "https://json.schemastore.org/block.json",
    "apiVersion": 3,
    "name": "meros/form-field",
    "version": "0.1.0",
    "title": "Form Field",
    "category": "widgets",
    "icon": "format-gallery",
    "description": "A form field block",
    "textdomain": "meros-theme",
    "example": {},
    "editorScript": "file:./index.js",
    "parent": [
        "meros/form-row"
    ],
    "attributes": {
        "id": {
            "type": "string",
            "default": ""
        },
        "type": {
            "type": "string",
            "default": "text"
        },
        "label": {
            "type": "string",
            "default": ""
        },
        "name": {
            "type": "string",
            "default": ""
        },
        "showIcon": {
            "type": "string",
            "default": "left"
        },
        "stringValue": {
            "type": "string",
            "default": ""
        },
        "booleanValue": {
            "type": "boolean",
            "default": false
        },
        "numberValue": {
            "type": "number",
            "default": 0
        },
        "selectedOptions": {
            "type": "array",
            "default": []
        },
        "placeholder": {
            "type": "string",
            "default": ""
        },
        "rows": {
            "type": "number",
            "default": 4
        },
        "options": {
            "type": "array",
            "default": []
        },
        "multiple": {
            "type": "boolean",
            "default": false
        },
        "horizontal": {
            "type": "boolean",
            "default": false
        },
        "useSwitch": {
            "type": "boolean",
            "default": false
        },
        "min": {
            "type": "number",
            "default": 0
        },
        "max": {
            "type": "number",
            "default": 100
        },
        "step": {
            "type": "number",
            "default": 1
        },
        "required": {
            "type": "boolean",
            "default": false
        },
        "disabled": {
            "type": "boolean",
            "default": false
        },
        "hidden": {
            "type": "boolean",
            "default": false
        },
        "conditions": {
            "type": "object",
            "default": {
                "show": [],
                "hide": [],
                "disable": [],
                "enable": [],
                "require": [],
                "optional": []
            }
        }
    },
    "variations": [
        {
            "name": "text",
            "title": "Text Field",
            "attributes": {
                "type": "text",
                "label": "Text Field",
                "placeholder": "Enter text",
                "name": "text-field"
            },
            "isActive": [
                "type"
            ],
            "isDefault": true
        },
        {
            "name": "email",
            "title": "Email Field",
            "attributes": {
                "type": "email",
                "label": "Email Field",
                "placeholder": "Enter email",
                "name": "email-field"
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "date",
            "title": "Date Field",
            "attributes": {
                "type": "date",
                "label": "Date Field",
                "placeholder": "Select date",
                "name": "date-field"
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "time",
            "title": "Time Field",
            "attributes": {
                "type": "time",
                "label": "Time Field",
                "placeholder": "Select time",
                "name": "time-field"
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "password",
            "title": "Password Field",
            "attributes": {
                "type": "password",
                "label": "Password Field",
                "placeholder": "Enter password",
                "name": "password-field"
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "textarea",
