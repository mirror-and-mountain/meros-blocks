        {
            "name": "radio-group",
            "title": "Radio Group",
            "attributes": {
                "type": "radio-group",
                "label": "Radio Group",
                "name": "radio-group",
                "options": [
                    {
                        "label": "Option 1",
                        "value": "option1"
                    },
                    {
                        "label": "Option 2",
                        "value": "option2"
                    },
                    {
                        "label": "Option 3",
