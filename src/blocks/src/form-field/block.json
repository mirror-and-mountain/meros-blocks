                "placeholder": "Enter text",
                "name": "textarea-field"
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "number",
            "title": "Number Field",
            "attributes": {
                "type": "number",
                "label": "Number Field",
                "placeholder": "Enter number",
                "name": "number-field",
                "min": 0,
                "max": 100,
                "step": 1
            },
            "isActive": [
                "type"
            ]
        },
        {
            "name": "range",
            "title": "Range Field",
            "attributes": {
                "type": "range",
