{
  "$schema": "https://json.schemastore.org/block.json",
  "apiVersion": 3,
  "name": "meros/form",
  "version": "0.1.0",
  "title": "Form",
  "category": "widgets",
  "icon": "format-gallery",
  "description": "A form block",
  "textdomain": "meros-theme",
  "example": {},
  "editorScript": "file:./index.js",
  "editorStyle": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "viewStyle": "file:./style-index.css",
  "allowedBlocks": [
    "meros/form-section"
  ],
  "supports": {
    "allowedBlocks": true,
    "layout": {
      "default": {
        "type": "constrained"
      },
      "allowCustomContentAndWideSize": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "color": {
      "background": true,
      "text": true
    }
  },
  "attributes": {
    "ref": {
      "type": "integer",
      "default": 0
    },
    "actions": {
      "type": "array",
      "default": []
    },
    "lock": {
      "type": "object",
      "default": {
        "move": true,
        "remove": true
      }
    }
  }
}