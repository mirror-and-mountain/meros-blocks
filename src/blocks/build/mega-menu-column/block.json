{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "meros/mega-menu-column",
  "version": "0.1.0",
  "title": "Mega Menu Column",
  "category": "widgets",
  "icon": "format-gallery",
  "description": "A column block for the navigation blocks with Mega Menu enabled",
  "textdomain": "meros-mega-menu",
  "example": {},
  "editorScript": "file:./index.js",
  "parent": [
    "core/navigation-submenu"
  ],
  "attributes": {
    "title": {
      "type": "string",
      "default": "Column Title"
    },
    "customHTML": {
      "type": "string",
      "default": ""
    },
    "grow": {
      "type": "boolean",
      "default": false
    }
  }
}