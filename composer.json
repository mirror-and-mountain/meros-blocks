{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-blocks",
    "description": "A collection of blocks and editor features for Meros powered WordPress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {},
    "require-dev": {
        "illuminate/testing": "^13.0",
        "mirror-and-mountain/meros-framework": "dev-main",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "MM\\Meros\\Blocks\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:integration": "phpunit -c phpunit.integration.xml"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mirror-and-mountain/meros-framework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/mirror-and-mountain/meros-foundations"
        }
    ],
    "autoload": {
        "psr-4": {
            "MM\\Meros\\Blocks\\": "src/",
            "MM\\Meros\\Blocks\\App\\": "src/app/",
            "MM\\Meros\\Blocks\\Support\\": "src/support/"
        }
    },
    "extra": {
        "meros": {
            "provider": "MM\\Meros\\Blocks\\ServiceProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
