{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-blocks",
    "description": "A collection of blocks and editor features for Meros powered WordPress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {},
    "autoload": {
        "psr-4": {
            "MM\\Meros\\Blocks\\": "src/"
        }
    },
    "extra": {
        "meros": {
            "loader": "MerosBlocks",
            "namespace": "MM\\Meros\\Blocks"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
